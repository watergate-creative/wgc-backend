<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { font-family: 'Segoe UI', Arial, sans-serif; background: #f4f4f7; margin: 0; padding: 0; -webkit-font-smoothing: antialiased; }
    .container { max-width: 600px; margin: 20px auto; background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
    .header { background: linear-gradient(135deg, #1a237e, #283593); color: #ffffff; text-align: center; padding: 28px 24px; }
    .header h1 { margin: 0; font-size: 24px; font-weight: 600; letter-spacing: -0.5px; }
    .body { padding: 32px 24px; color: #333333; line-height: 1.6; }
    .body h2 { color: #1a237e; margin-top: 0; font-size: 20px; font-weight: 600; }
    .session-card { background: #f8f9fa; border: 1px solid #e2e8f0; border-top: 4px solid #1a237e; border-radius: 8px; padding: 24px; margin: 24px 0; }
    .session-title { font-size: 18px; font-weight: 700; color: #1e293b; margin: 0 0 12px 0; padding-bottom: 12px; border-bottom: 1px solid #e2e8f0; }
    .detail-row { margin-bottom: 14px; }
    .detail-row:last-child { margin-bottom: 0; }
    .detail-label { font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; letter-spacing: 0.5px; display: block; margin-bottom: 2px; }
    .detail-value { font-size: 15px; color: #1e293b; font-weight: 500; }
    .purpose-box { background: #ffffff; border-left: 3px solid #cbd5e1; padding: 12px 16px; margin: 20px 0; font-size: 14px; color: #475569; font-style: italic; }
    .footer { text-align: center; padding: 24px; font-size: 12px; color: #94a3b8; border-top: 1px solid #f1f5f9; background: #fafafa; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Session Booking Confirmed!</h1>
    </div>

    <div class="body">
      <h2>Hello {{guestName}},</h2>
      <p>Your session with <strong>{{ministerTitle}} {{ministerName}}</strong> has been successfully booked. Please see the details below.</p>

      <div class="session-card">
        <div class="session-title">Session Details</div>

        <div class="detail-row">
          <span class="detail-label">Minister</span>
          <span class="detail-value">🙏 {{ministerTitle}} — {{ministerName}}</span>
        </div>

        <div class="detail-row">
          <span class="detail-label">Date & Time</span>
          <span class="detail-value">📅 {{sessionDate}} &nbsp;&bull;&nbsp; 🕐 {{sessionTime}}</span>
        </div>

        <div class="detail-row">
          <span class="detail-label">Duration</span>
          <span class="detail-value">⏱ {{durationMinutes}} minutes</span>
        </div>

        {{#if sessionId}}
        <div class="detail-row" style="margin-top: 16px; padding-top: 12px; border-top: 1px dashed #cbd5e1;">
          <span class="detail-label">Booking Reference</span>
          <span style="font-family: monospace; font-size: 16px; font-weight: bold; color: #1a237e;">#{{sessionId}}</span>
        </div>
        {{/if}}
      </div>

      {{#if purpose}}
      <div class="purpose-box">
        <strong>Purpose:</strong> {{purpose}}
      </div>
      {{/if}}

      <p>If you need to reschedule or cancel, please reply directly to this email or contact the church office.</p>
      <p style="margin-top: 24px; font-weight: 600; color: #1a237e;">God bless you! 🙏</p>
    </div>
    <div class="footer">
      <p>&copy; {{year}} Watergate Church Global. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
