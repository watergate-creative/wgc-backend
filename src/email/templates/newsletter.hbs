<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { font-family: Arial, sans-serif; background: #edf2ef; margin: 0; padding: 0; color: #263331; -webkit-font-smoothing: antialiased; }
    .container { max-width: 600px; margin: 20px auto; background: #ffffff; border: 1px solid #dce5df; border-radius: 10px; overflow: hidden; }
    .header { background: #173d3a; border-bottom: 4px solid #d3aa58; color: #ffffff; text-align: center; padding: 32px 24px; }
    .header h1 { margin: 0; font-family: Georgia, serif; font-size: 25px; line-height: 1.3; font-weight: 600; }
    .body { padding: 32px 28px; color: #34413d; line-height: 1.7; }
    .newsletter-content { font-size: 15px; color: #263331; }
    .newsletter-content img { max-width: 100%; height: auto; border-radius: 6px; }
    .newsletter-content h1, .newsletter-content h2, .newsletter-content h3 { color: #17615b; font-family: Georgia, serif; }
    .newsletter-content a { color: #17615b; text-decoration: underline; }
    .divider { height: 1px; background: #dce5df; margin: 24px 0; }
    .footer { text-align: center; padding: 24px; font-size: 12px; color: #74827b; border-top: 1px solid #dce5df; background: #f7f9f6; }
    .footer a { color: #52675e; text-decoration: underline; }
    @media only screen and (max-width: 620px) { .container { margin: 0 auto; border-radius: 0; } .body { padding: 26px 20px; } }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>{{subject}}</h1>
    </div>
    <div class="body">
      {{#if preheader}}
      <p style="font-size: 14px; color: #64748b; margin-top: 0;">{{preheader}}</p>
      <div class="divider"></div>
      {{/if}}

      <div class="newsletter-content">
        {{{htmlContent}}}
      </div>

      <div class="divider"></div>
      <p style="font-size: 13px; color: #94a3b8; text-align: center;">
        You are receiving this email because you are connected with Watergate Church Global.
      </p>
    </div>
    <div class="footer">
      <p>&copy; {{year}} Watergate Church Global. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
