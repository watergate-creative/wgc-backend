<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { font-family: 'Segoe UI', Arial, sans-serif; background: #f4f4f7; margin: 0; padding: 0; -webkit-font-smoothing: antialiased; }
    .container { max-width: 600px; margin: 20px auto; background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
    .header { background: linear-gradient(135deg, #1a237e, #283593); color: #ffffff; text-align: center; padding: 28px 24px; }
    .header h1 { margin: 0; font-size: 24px; font-weight: 600; letter-spacing: -0.5px; }
    
    /* Responsive Banner Styling */
    .banner-container { width: 100%; background: #000000; text-align: center; line-height: 0; }
    .banner-img { width: 100%; max-width: 600px; height: auto; display: block; border-bottom: 3px solid #1a237e; }
    
    .body { padding: 32px 24px; color: #333333; line-height: 1.6; }
    .body h2 { color: #1a237e; margin-top: 0; font-size: 20px; font-weight: 600; }
    
    /* Event Details Card */
    .ticket-card { background: #f8f9fa; border: 1px solid #e2e8f0; border-top: 4px solid #1a237e; border-radius: 8px; padding: 24px; margin: 24px 0; }
    .event-title { font-size: 18px; font-weight: 700; color: #1e293b; margin: 0 0 12px 0; padding-bottom: 12px; border-bottom: 1px solid #e2e8f0; }
    .ticket-row { margin-bottom: 14px; }
    .ticket-row:last-child { margin-bottom: 0; }
    .ticket-label { font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; letter-spacing: 0.5px; display: block; margin-bottom: 2px; }
    .ticket-value { font-size: 15px; color: #1e293b; font-weight: 500; }
    
    /* Highlight Badge for Schedule */
    .schedule-badge { display: inline-block; background: #e0e7ff; color: #1a237e; padding: 4px 10px; border-radius: 6px; font-size: 13px; font-weight: 600; margin-top: 4px; }
    
    .description-box { background: #ffffff; border-left: 3px solid #cbd5e1; padding: 12px 16px; margin: 20px 0; font-size: 14px; color: #475569; font-style: italic; }
    
    .btn-container { text-align: center; margin: 32px 0 24px 0; }
    .btn { background: #1a237e; color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 6px; font-weight: bold; display: inline-block; font-size: 15px; box-shadow: 0 2px 4px rgba(26, 35, 126, 0.2); }
    .footer { text-align: center; padding: 24px; font-size: 12px; color: #94a3b8; border-top: 1px solid #f1f5f9; background: #fafafa; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Registration Confirmed!</h1>
    </div>
    
    {{#if bannerImageUrl}}
    <div class="banner-container">
      <img src="{{bannerImageUrl}}" alt="{{title}} Event Banner" class="banner-img" />
    </div>
    {{/if}}

    <div class="body">
      <h2>Hello {{firstName}},</h2>
      <p>We are thrilled to let you know that your registration for <strong>{{title}}</strong> has been successfully processed! Your seat is reserved, and we cannot wait to host you.</p>
      
      <div class="ticket-card">
        <div class="event-title">{{title}}</div>
        
        <div class="ticket-row">
          <span class="ticket-label">Date & Duration</span>
          <span class="ticket-value">
            📅 {{startDate}}
            {{#if endDate}}
               &nbsp;&ndash;&nbsp; {{endDate}}
            {{/if}}
          </span>
        </div>

        {{#if selectedDays}}
        <div class="ticket-row">
          <span class="ticket-label">Your Selected Days</span>
          <div style="margin-top: 4px;">
            {{#each selectedDays}}
              <span class="schedule-badge">📅 {{this}}</span>
            {{/each}}
          </div>
        </div>
        {{/if}}

        <div class="ticket-row">
          <span class="ticket-label">Location</span>
          <span class="ticket-value">📍 {{location}}</span>
        </div>

        {{#if registrationId}}
        <div class="ticket-row" style="margin-top: 16px; padding-top: 12px; border-top: 1px dashed #cbd5e1;">
          <span class="ticket-label">Registration ID / Ticket Number</span>
          <span style="font-family: monospace; font-size: 16px; font-weight: bold; color: #1a237e;">#{{registrationId}}</span>
        </div>
        {{/if}}
      </div>

      {{#if description}}
      <div class="description-box">
        {{description}}
      </div>
      {{/if}}

      {{#if actionUrl}}
      <div class="btn-container">
        <a href="{{actionUrl}}" class="btn">View Event Details & Guide</a>
      </div>
      {{/if}}

      <p>If you have any questions or need to make adjustments to your reservation, simply reply directly to this email.</p>
      <p style="margin-top: 24px; font-weight: 600; color: #1a237e;">God bless you! 🙏</p>
    </div>
    <div class="footer">
      <p>&copy; {{year}} Watergate Church Global. All rights reserved.</p>
    </div>
  </div>
</body>
</html>