<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { font-family: Arial, sans-serif; background: #edf2ef; margin: 0; padding: 0; color: #263331; -webkit-font-smoothing: antialiased; }
    .container { max-width: 600px; margin: 20px auto; background: #ffffff; border: 1px solid #dce5df; border-radius: 10px; overflow: hidden; }
    .header { background: #173d3a; border-bottom: 4px solid #d3aa58; color: #ffffff; text-align: center; padding: 36px 24px; }
    .header h1 { margin: 0; font-family: Georgia, serif; font-size: 25px; line-height: 1.3; font-weight: 600; }
    .body { padding: 32px 28px; color: #34413d; line-height: 1.7; }
    .body h2 { color: #17615b; margin-top: 0; font-size: 20px; }
    .meta-bar { background: #eaf2ed; border-left: 3px solid #8db7a8; padding: 14px 16px; border-radius: 4px; font-size: 13px; color: #43534c; margin-bottom: 24px; }
    .data-table { width: 100%; border-collapse: collapse; margin: 20px 0; }
    .data-table th { text-align: left; padding: 10px; background: #f5f7f3; color: #617168; font-size: 12px; text-transform: uppercase; border-bottom: 2px solid #dce5df; width: 35%; }
    .data-table td { padding: 12px 10px; border-bottom: 1px solid #dce5df; color: #263331; font-size: 14px; }
    .btn-container { text-align: center; margin: 30px 0; }
    .btn { background: #17615b; color: #ffffff; text-decoration: none; padding: 12px 24px; border-radius: 5px; font-weight: bold; display: inline-block; font-size: 14px; }
    .footer { text-align: center; padding: 20px; font-size: 12px; color: #74827b; border-top: 1px solid #dce5df; background: #f7f9f6; }
    @media only screen and (max-width: 620px) { .container { margin: 0 auto; border-radius: 0; } .body { padding: 26px 20px; } .data-table th, .data-table td { padding: 9px 7px; overflow-wrap: anywhere; } }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>New Form Submission</h1>
    </div>
    <div class="body">
      <h2>{{formTitle}}</h2>
      
      <div class="meta-bar">
        <strong>Submitted By:</strong> {{submittedBy}} <br>
        <strong>Date:</strong> {{submittedAt}}
      </div>

      <p>A new submission has been received. Here are the details provided:</p>

      <table class="data-table">
        <tbody>
          {{#each formFields}}
          <tr>
            <th>{{this.label}}</th>
            <td>{{this.value}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>

      {{#if adminNotes}}
      <div style="background: #fff3cd; color: #856404; padding: 12px; border-radius: 6px; font-size: 13px; margin-top: 16px;">
        <strong>Note:</strong> {{adminNotes}}
      </div>
      {{/if}}

      {{#if actionUrl}}
      <div class="btn-container">
        <a href="{{actionUrl}}" class="btn">View in Portal / Follow Up</a>
      </div>
      {{/if}}

      <p style="font-size: 13px; color: #64748b; margin-top: 32px;">This is an automated system notification from {{appName}}.</p>
    </div>
    <div class="footer">
      <p>&copy; {{year}} Watergate Church Global. All rights reserved.</p>
    </div>
  </div>
</body>
</html>