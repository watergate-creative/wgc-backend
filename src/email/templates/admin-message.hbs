<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; margin: 0; padding: 0; }
    .container { max-width: 600px; margin: 0 auto; padding: 20px; }
    .header { background-color: #f8f9fa; padding: 15px; border-bottom: 3px solid #0056b3; margin-bottom: 20px; }
    .category-badge { display: inline-block; padding: 5px 10px; background-color: #e9ecef; color: #495057; font-size: 12px; font-weight: bold; border-radius: 3px; text-transform: uppercase; margin-bottom: 10px; }
    .category-high { background-color: #dc3545; color: white; }
    .content { padding: 0 15px; }
    .footer { margin-top: 30px; padding-top: 15px; border-top: 1px solid #ddd; font-size: 12px; color: #6c757d; text-align: center; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      {{#if priority}}
        {{#if (eq priority 'HIGH')}}
          <div class="category-badge category-high">Urgent Notice</div>
        {{else}}
          <div class="category-badge">Important Notice</div>
        {{/if}}
      {{else}}
        <div class="category-badge">Important Notice</div>
      {{/if}}
      <h2 style="margin: 0; color: #0056b3;">{{subject}}</h2>
    </div>
    
    <div class="content">
      {{{htmlContent}}}
    </div>

    <div class="footer">
      <p>This is an administrative message from Watergate Church.</p>
      <p>Please do not reply directly to this email.</p>
    </div>
  </div>
</body>
</html>
