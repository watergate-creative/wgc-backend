<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.7; color: #34413d; background: #edf2ef; margin: 0; padding: 0; -webkit-font-smoothing: antialiased; }
    .container { max-width: 600px; margin: 20px auto; background: #ffffff; border: 1px solid #dce5df; border-radius: 10px; overflow: hidden; }
    .header { background: #173d3a; color: #ffffff; padding: 28px; border-bottom: 4px solid #d3aa58; }
    .category-badge { display: inline-block; padding: 5px 10px; background: #eaf2ed; color: #17615b; font-size: 11px; font-weight: bold; border-radius: 3px; text-transform: uppercase; margin-bottom: 10px; }
    .category-high { background: #f8e8df; color: #9a3c24; }
    .content { padding: 24px 28px; color: #263331; }
    .content img { max-width: 100%; height: auto; }
    .content a { color: #17615b; }
    .footer { margin-top: 10px; padding: 20px 24px; border-top: 1px solid #dce5df; font-size: 12px; color: #74827b; text-align: center; background: #f7f9f6; }
    @media only screen and (max-width: 620px) { .container { margin: 0 auto; border-radius: 0; } .content { padding: 22px 20px; } .header { padding: 24px 20px; } }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      {{#if priority}}
        {{#if (eq priority 'HIGH')}}
          <div class="category-badge category-high">Urgent Notice</div>
        {{else}}
          <div class="category-badge">Important Notice</div>
        {{/if}}
      {{else}}
        <div class="category-badge">Important Notice</div>
      {{/if}}
      <h2 style="margin: 0; color: #ffffff; font-family: Georgia, serif; font-size: 23px; line-height: 1.35;">{{subject}}</h2>
    </div>
    
    <div class="content">
      {{{htmlContent}}}
    </div>

    <div class="footer">
      <p>This is an administrative message from Watergate Church.</p>
      <p>Please do not reply directly to this email.</p>
    </div>
  </div>
</body>
</html>
