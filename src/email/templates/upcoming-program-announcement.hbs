<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { font-family: 'Segoe UI', Arial, sans-serif; background: #f4f4f7; margin: 0; padding: 0; -webkit-font-smoothing: antialiased; }
    .container { max-width: 600px; margin: 20px auto; background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
    .header { background: linear-gradient(135deg, #1a237e, #283593); color: #ffffff; text-align: center; padding: 36px 24px; }
    .header h1 { margin: 0; font-size: 24px; font-weight: 600; letter-spacing: -0.5px; }
    .header .emoji { font-size: 36px; display: block; margin-bottom: 12px; }
    .banner-container { width: 100%; background: #000000; text-align: center; line-height: 0; }
    .banner-img { width: 100%; max-width: 600px; height: auto; display: block; border-bottom: 3px solid #1a237e; }
    .body { padding: 32px 24px; color: #333333; line-height: 1.7; }
    .body h2 { color: #1a237e; margin-top: 0; font-size: 20px; font-weight: 600; }
    .program-card { background: #f8f9fa; border: 1px solid #e2e8f0; border-top: 4px solid #1a237e; border-radius: 8px; padding: 24px; margin: 24px 0; }
    .program-title { font-size: 18px; font-weight: 700; color: #1e293b; margin: 0 0 16px 0; padding-bottom: 12px; border-bottom: 1px solid #e2e8f0; }
    .detail-row { margin-bottom: 12px; }
    .detail-label { font-size: 11px; text-transform: uppercase; color: #64748b; font-weight: 700; letter-spacing: 0.5px; display: block; margin-bottom: 2px; }
    .detail-value { font-size: 15px; color: #1e293b; font-weight: 500; }
    .description-box { background: #ffffff; border-left: 3px solid #cbd5e1; padding: 12px 16px; margin: 20px 0; font-size: 14px; color: #475569; }
    .btn-container { text-align: center; margin: 32px 0 24px 0; }
    .btn { background: #1a237e; color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 6px; font-weight: bold; display: inline-block; font-size: 15px; box-shadow: 0 2px 4px rgba(26, 35, 126, 0.2); }
    .footer { text-align: center; padding: 24px; font-size: 12px; color: #94a3b8; border-top: 1px solid #f1f5f9; background: #fafafa; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <span class="emoji">📣</span>
      <h1>Upcoming Program!</h1>
    </div>

    {{#if bannerImageUrl}}
    <div class="banner-container">
      <img src="{{bannerImageUrl}}" alt="{{programName}} Banner" class="banner-img" />
    </div>
    {{/if}}

    <div class="body">
      <h2>Hello {{recipientName}},</h2>
      <p>We are excited to announce an upcoming program that you do not want to miss!</p>

      <div class="program-card">
        <div class="program-title">{{programName}}</div>

        <div class="detail-row">
          <span class="detail-label">Date</span>
          <span class="detail-value">📅 {{startDate}}</span>
        </div>

        <div class="detail-row">
          <span class="detail-label">Location</span>
          <span class="detail-value">📍 {{location}}</span>
        </div>
      </div>

      {{#if description}}
      <div class="description-box">
        {{description}}
      </div>
      {{/if}}

      {{#if actionUrl}}
      <div class="btn-container">
        <a href="{{actionUrl}}" class="btn">Learn More & Register</a>
      </div>
      {{/if}}

      <p>Mark your calendars, invite a friend, and get ready for a powerful time in God's presence!</p>
      <p style="margin-top: 24px; font-weight: 600; color: #1a237e;">God bless you! 🙏</p>
    </div>
    <div class="footer">
      <p>&copy; {{year}} Watergate Church Global. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
