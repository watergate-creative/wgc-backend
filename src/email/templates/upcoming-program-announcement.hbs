<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { font-family: Arial, sans-serif; background: #edf2ef; margin: 0; padding: 0; color: #263331; -webkit-font-smoothing: antialiased; }
    .container { max-width: 600px; margin: 20px auto; background: #ffffff; border: 1px solid #dce5df; border-radius: 10px; overflow: hidden; }
    .header { background: #173d3a; border-bottom: 4px solid #d3aa58; color: #ffffff; text-align: center; padding: 36px 24px; }
    .header h1 { margin: 0; font-family: Georgia, serif; font-size: 25px; line-height: 1.3; font-weight: 600; }
    .header .emoji { font-size: 36px; display: block; margin-bottom: 12px; }
    .banner-container { width: 100%; background: #000000; text-align: center; line-height: 0; }
    .banner-img { width: 100%; max-width: 600px; height: auto; display: block; border-bottom: 3px solid #d3aa58; }
    .body { padding: 32px 28px; color: #34413d; line-height: 1.7; }
    .body h2 { color: #17615b; margin-top: 0; font-size: 20px; font-weight: 600; }
    .program-card { background: #f5f7f3; border: 1px solid #dce5df; border-left: 4px solid #d3aa58; border-radius: 6px; padding: 24px; margin: 24px 0; }
    .program-title { font-size: 19px; font-weight: 700; color: #263331; margin: 0 0 16px 0; padding-bottom: 12px; border-bottom: 1px solid #dce5df; }
    .detail-row { margin-bottom: 12px; }
    .detail-label { font-size: 11px; text-transform: uppercase; color: #718078; font-weight: 700; letter-spacing: 0.5px; display: block; margin-bottom: 2px; }
    .detail-value { font-size: 15px; color: #263331; font-weight: 500; }
    .description-box { background: #fbfcfa; border-left: 3px solid #8db7a8; padding: 12px 16px; margin: 20px 0; font-size: 14px; color: #4b5a54; }
    .btn-container { text-align: center; margin: 32px 0 24px 0; }
    .btn { background: #17615b; color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 5px; font-weight: bold; display: inline-block; font-size: 15px; }
    .footer { text-align: center; padding: 24px; font-size: 12px; color: #74827b; border-top: 1px solid #dce5df; background: #f7f9f6; }
    @media only screen and (max-width: 620px) { .container { margin: 0 auto; border-radius: 0; } .body { padding: 26px 20px; } .program-card { padding: 18px; } }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <span class="emoji">📣</span>
      <h1>Upcoming Program!</h1>
    </div>

    {{#if bannerImageUrl}}
    <div class="banner-container">
      <img src="{{bannerImageUrl}}" alt="{{programName}} Banner" class="banner-img" />
    </div>
    {{/if}}

    <div class="body">
      <h2>Hello {{recipientName}},</h2>
      <p>We are excited to announce an upcoming program that you do not want to miss!</p>

      <div class="program-card">
        <div class="program-title">{{programName}}</div>

        <div class="detail-row">
          <span class="detail-label">Date</span>
          <span class="detail-value">📅 {{startDate}}</span>
        </div>

        <div class="detail-row">
          <span class="detail-label">Location</span>
          <span class="detail-value">📍 {{location}}</span>
        </div>
      </div>

      {{#if description}}
      <div class="description-box">
        {{description}}
      </div>
      {{/if}}

      {{#if actionUrl}}
      <div class="btn-container">
        <a href="{{actionUrl}}" class="btn">Learn More & Register</a>
      </div>
      {{/if}}

      <p>Mark your calendars, invite a friend, and get ready for a powerful time in God's presence!</p>
      <p style="margin-top: 24px; font-weight: 600; color: #17615b;">God bless you! 🙏</p>
    </div>
    <div class="footer">
      <p>&copy; {{year}} Watergate Church Global. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
